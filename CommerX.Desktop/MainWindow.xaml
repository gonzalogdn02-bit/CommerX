<Window x:Class="CommerX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
       xmlns:views="clr-namespace:CommerX.InterfaceAdapter.Views.Clients;assembly=CommerX.InterfaceAdapter.Views"
        Title="CommerX" Height="760" Width="620"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0">
            <TextBlock Text="CommerX" FontSize="28" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" Text="Base de datos: sin comprobar" FontSize="14" VerticalAlignment="Center" />
                <Button Content="Comprobar conexión" Click="OnCheckConnection" Padding="12,4" Margin="16,0,0,0" />
            </StackPanel>
        </StackPanel>

        <blazor:BlazorWebView x:Name="BlazorView" HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type views:CreateClient}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </DockPanel>
</Window>